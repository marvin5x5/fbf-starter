{
  "name": "fbf-starter",
  "version": "1.0.0",
  "description": "Reusable de-branded Elementor child-theme starter (Hello Elementor child).",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "init": "node scripts/init.mjs",
    "build:css": "sass scss/main.scss:assets/css/main.css --style=compressed --no-source-map",
    "watch:css": "sass --watch scss/main.scss:assets/css/main.css --style=expanded"
  },
  "devDependencies": {
    "sass": "^1.77.0"
  }
}
