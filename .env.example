# ── Theme identity ────────────────────────────────────────────────────────────
# Stamped into style.css, functions.php, CLAUDE.md, and the .claude role skills
# by `npm run init`. Copy this file to .env and fill it in.
# NOTE: .env is tracked in git — keep secrets (keys/credentials/SSH) OUT of it.
CLIENT_NAME="Client Name"
THEME_AUTHOR="Five by Five"
PARENT_THEME="hello-elementor"
THEME_HANDLE_PREFIX="theme"

# ── Optional design-token seeds ────────────────────────────────────────────────
# Leave blank to keep the #000 /* TODO */ placeholders in scss/abstracts/_tokens.scss.
BRAND_PRIMARY=""
BRAND_ACCENT=""
FONT_SANS=""
FONT_SERIF=""
GOOGLE_FONTS_URL=""
